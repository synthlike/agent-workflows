{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synthlike/agent-workflows/schema/migration-snapshot-v1.json",
  "title": "Portable semantic record migration snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "record_type",
    "source",
    "identity",
    "title",
    "content",
    "content_sha256",
    "created",
    "modified",
    "lifecycle",
    "provenance",
    "issue"
  ],
  "properties": {
    "snapshot_version": {"const": 1},
    "record_type": {"$ref": "#/$defs/recordType"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_instance", "backend_type", "reference", "revision"],
      "properties": {
        "backend_instance": {"$ref": "#/$defs/nonempty"},
        "backend_type": {"$ref": "#/$defs/nonempty"},
        "reference": {"$ref": "#/$defs/reference"},
        "revision": {"$ref": "#/$defs/nonempty"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id", "provider_id"],
      "properties": {
        "semantic_id": {"$ref": "#/$defs/nonempty"},
        "provider_id": {"$ref": "#/$defs/nonempty"}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "content_sha256": {"$ref": "#/$defs/digest"},
    "created": {"$ref": "#/$defs/timestamp"},
    "modified": {"$ref": "#/$defs/timestamp"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "archived"],
      "properties": {
        "state": {
          "enum": ["active", "archived", "open", "resolved", "cancelled"]
        },
        "archived": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "array",
      "items": {"$ref": "#/$defs/provenance"}
    },
    "issue": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/issue"}
      ]
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 1},
    "recordType": {
      "enum": [
        "issues", "domain", "arps", "rfcs", "specs", "meetings",
        "research", "questionnaires", "technical_baselines",
        "problem_framing", "prototypes", "handoffs"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "id", "title", "href"],
      "properties": {
        "backend": {"$ref": "#/$defs/nonempty"},
        "id": {"$ref": "#/$defs/nonempty"},
        "title": {"$ref": "#/$defs/nonempty"},
        "href": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "name", "value"],
      "properties": {
        "classification": {
          "enum": [
            "portable-native",
            "portable-represented",
            "provider-informational",
            "provider-required",
            "unsupported"
          ]
        },
        "name": {"$ref": "#/$defs/nonempty"},
        "value": {}
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "created", "body", "reference"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "author": {"$ref": "#/$defs/nonempty"},
        "created": {"$ref": "#/$defs/timestamp"},
        "body": {"type": "string"},
        "reference": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reference"}
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {"enum": ["parent", "blocks"]},
        "target": {"$ref": "#/$defs/reference"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "status", "assignee", "labels", "comments", "relationships"
      ],
      "properties": {
        "kind": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["open", "resolved", "cancelled"]},
        "assignee": {"type": ["string", "null"]},
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "comments": {
          "type": "array",
          "items": {"$ref": "#/$defs/comment"}
        },
        "relationships": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationship"}
        }
      }
    }
  }
}
